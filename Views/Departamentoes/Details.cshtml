@model at_cnet.Models.Departamento

@{
    ViewData["Title"] = "Detalhes do Departamento";
}

<h1>@ViewData["Title"]</h1>

<div>
    <h4>Departamento</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.nome)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.nome)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.local)
        </dt>
        <dd class = "col-sm-10">
            @Model.local.ToString()
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.funcionarios)
        </dt>
        <dd class="col-sm-10">
            @foreach (var funcionario in Model.funcionarios)
            {
              <p> @funcionario.nome (@funcionario.id) </p>
            }
        </dd>
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model?.id">Edit</a> |
    <a asp-action="Index">Back to List</a>
</div>
